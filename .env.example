# Copia este archivo como .env para probar en local. En producción, define las variables en el hosting.

# URL pública del sitio, sin barra final. Por defecto: https://marcador-kohl.vercel.app
# Ojo: SITE_URL se lee en astro.config.mjs, así que en local hay que pasarla en el comando
# (SITE_URL=https://canterastats.com npm run build); en el hosting basta con definirla.
# SITE_URL=https://canterastats.com

# ID del sitio en Umami Cloud (Settings → Websites). Si se deja vacío, no se carga analítica.
PUBLIC_UMAMI_WEBSITE_ID=

# Opcional: código de verificación de Google Search Console por etiqueta meta.
# Es preferible verificar el dominio por DNS y dejar esto vacío.
PUBLIC_GSC_VERIFICATION=
