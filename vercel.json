{
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/app", "destination": "/minibasket-stats/", "permanent": false },
    { "source": "/app/", "destination": "/minibasket-stats/", "permanent": false },
    {
      "source": "/:path((?!minibasket-stats|marcador).*)",
      "has": [{ "type": "host", "value": "marcador-kohl.vercel.app" }],
      "destination": "https://myownbasketballstats.com/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/minibasket-stats/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
