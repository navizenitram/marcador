{
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/app", "destination": "/minibasket-stats/", "permanent": false },
    { "source": "/app/", "destination": "/minibasket-stats/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/minibasket-stats/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
