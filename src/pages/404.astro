---
import Base from '../layouts/Base.astro';
import { APP_URL } from '../consts';
---
<Base title="Página no encontrada · Cantera Stats" description="Esta página no existe." noindex>
  <section class="article">
    <div class="wrap">
      <header class="article-head">
        <h1>Esta página no existe</h1>
        <p class="lead">Puede que el enlace esté mal escrito o que la página se haya movido.</p>
      </header>
      <div class="actions">
        <a class="btn btn-primary" href={APP_URL} data-umami-event="abrir-app" data-umami-event-origen="404">Abrir la app</a>
        <a class="btn btn-ghost" href="/">Ir a la portada</a>
      </div>
    </div>
  </section>
</Base>
